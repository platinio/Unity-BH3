 becomes the agent''s resource fact and the caller re-enters pointing there. Nothing left: completedGatherOrder = acceptedGatherOrder, and the gather guard turns false.","colorTheme":"Classic","guid":"e7985a25-2ea4-45af-89aa-bda11ee37e67","$type":"ArcaneOnyx.GraphCore.StickyNote"},{"$ref":"33"},{"$ref":"64"},{"$ref":"86"},{"$ref":"102"},{"$ref":"23"},{"$ref":"106"},{"$ref":"47"},{"$ref":"76"},{"$ref":"51"},{"$ref":"30"},{"VariableKind":"Graph","NodeComment":null,"relations":{"$content":[],"$type":"Unity.VisualScripting.ConnectionCollection`3[[ArcaneOnyx.BehaviorTree.IPortRelation, ArcaneOnyx.BehaviorTree, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null],[ArcaneOnyx.BehaviorTree.IPort, ArcaneOnyx.BehaviorTree, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null],[ArcaneOnyx.BehaviorTree.IPort, ArcaneOnyx.BehaviorTree, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null]]"},"position":{"x":0.0,"y":0.0},"defaultValues":{"Key":{"$content":"acceptedGatherOrder","$type":"System.String"}},"LastExecutionStatus":"None","runtimeException":null,"positionRect":{"xMin":6920.0,"yMin":1270.5,"xMax":7070.0,"yMax":1358.5},"guid":"67fa181c-9dbe-4c73-8a58-03fcb7498563","$type":"ArcaneOnyx.BehaviorTree.GetVariable","$id":"139"},{"$ref":"68"},{"ScriptGraphVariable":{"returnType":"System.Object, mscorlib, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089","function":0,"$id":"143"},"parameters":[{"Name":"target","Type":"UnityEngine.GameObject","Optional":false,"DefaultValue":null}],"resultType":"UnityEngine.Transform","scriptGraphVariables":[{"$ref":"143"}],"comment":"TransformOf(resource)","relations":{"$content":[],"$type":"Unity.VisualScripting.ConnectionCollection`3[[ArcaneOnyx.BehaviorTree.IPortRelation, ArcaneOnyx.BehaviorTree, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null],[ArcaneOnyx.BehaviorTree.IPort, ArcaneOnyx.BehaviorTree, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null],[ArcaneOnyx.BehaviorTree.IPort, ArcaneOnyx.BehaviorTree, Version=0